    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  r.rental_id,\n  r.client_id,\n  r.equipment_id,\n  r.expected_return_time,\n  r.status                 AS rental_status,\n  r.total_price,\n  r.return_call_attempts,\n  c.full_name              AS client_name,\n  c.phone_number           AS client_phone,\n  c.company_name,\n  COALESCE(e.model_name,        pd.equipment_requested) AS items_list,\n  COALESCE(e.daily_rate,        pd.client_final_rate)   AS daily_rate,\n  COALESCE(e.late_fee_per_hour, 0)                      AS late_fee,\n  CASE\n    WHEN r.equipment_id IS NOT NULL THEN 'OWNED'\n    ELSE 'PARTNER'\n  END AS source\nFROM rentals r\nJOIN clients c\n  ON r.client_id = c.client_id\nLEFT JOIN equipment_inventory e\n  ON r.equipment_id = e.equipment_id\nLEFT JOIN partners_dispatch pd\n  ON pd.rental_id = r.rental_id\n  AND r.equipment_id IS NULL\nWHERE r.status IN ('active', 'extended', 'overdue')\n  AND r.return_call_attempts < 3\n  AND (\n    r.expected_return_time <= NOW() + INTERVAL '3 hours'\n    OR r.expected_return_time < NOW()\n  )\nORDER BY r.return_call_attempts ASC, r.expected_return_time ASC\nLIMIT 1;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -1680,
        224
      ],
      "id": "3abfa65d-76ca-4025-bb6c-8b371f9371bf",
      "name": "Execute a SQL query",
      "credentials": {
        "postgres": {
          "id": "YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const grouped = {};\n\nfor (const item of $input.all()) {\n  const phone = item.json.client_phone;\n  const data  = item.json;\n\n  if (!grouped[phone]) {\n    grouped[phone] = {\n      client_name:   data.client_name,\n      client_phone:  phone,\n      company_name:  data.company_name,\n      rental_ids:    [],\n      equipment_ids: [],\n      items_list:    [],\n      sources:       [],\n      late_fees:     [],\n      daily_rates:   [],\n      return_times:  []\n    };\n  }\n\n  grouped[phone].rental_ids.push(data.rental_id);\n  grouped[phone].equipment_ids.push(data.equipment_id ?? 'null');\n  // null items_list ko handle karo\n  grouped[phone].items_list.push(data.items_list ?? 'Unknown Equipment');\n  grouped[phone].sources.push(data.source);\n  grouped[phone].late_fees.push(String(data.late_fee ?? '0'));\n  grouped[phone].daily_rates.push(String(data.daily_rate ?? '0'));\n  grouped[phone].return_times.push(data.expected_return_time);\n}\n\nconst result = [];\n\nfor (const key in grouped) {\n  const g = grouped[key];\n\n  const allOwned   = g.sources.every(s => s === 'OWNED');\n  const allPartner = g.sources.every(s => s === 'PARTNER');\n\n  // MIXED → skip, Ali jaisa case\n  if (!allOwned && !allPartner) continue;\n\n  result.push({ json: {\n    client_name:   g.client_name,\n    client_phone:  g.client_phone,\n    company_name:  g.company_name,\n    rental_ids:    g.rental_ids.join(','),\n    equipment_ids: g.equipment_ids.join(','),\n    items_list:    g.items_list.join(', '),\n    sources:       g.sources.join(','),\n    late_fees:     g.late_fees.join(','),\n    daily_rates:   g.daily_rates.join(','),\n    return_times:  g.return_times.join(','),\n    call_type:     allOwned ? 'OWNED' : 'PARTNER'\n  }});\n}\n\nreturn result;"
      },
