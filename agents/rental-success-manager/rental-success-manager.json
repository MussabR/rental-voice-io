    {
      "parameters": {
        "jsCode": "const body = $json.body;\nconst rentalIds = body.rental_ids.split(',');\nconst dailyRates = body.daily_rates.split(',').map(r => parseFloat(r));\nconst itemsList = body.items_list.split(',');\nconst returnTimes = body.return_times.split(',');\n\nconst newReturn = new Date(body.new_return_time);\nconst results = [];\n\nfor (let i = 0; i < rentalIds.length; i++) {\n  const oldReturn = new Date(returnTimes[i]);\n  // Calculate Days for this specific item\n  const extraDays = Math.ceil((newReturn - oldReturn) / (1000 * 60 * 60 * 24));\n  const itemExtraAmount = (dailyRates[i] * extraDays).toFixed(2);\n\n  results.push({\n    json: {\n      ...body, // Original data rakho reference ke liye\n      current_rental_id: rentalIds[i].trim(),\n      current_item_name: itemsList[i].trim(),\n      current_daily_rate: dailyRates[i],\n      extra_days: extraDays,\n      item_extra_amount: itemExtraAmount\n    }\n  });\n}\n\nreturn results;"
      },
